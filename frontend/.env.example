# متغیرهای محیطی فرانت‌اند Next.js 16 (فاز ۹ — ADR-0035 و ADR-0036)
# در توسعهٔ محلی به .env.local کپی کنید؛ در cPanel در بخش Setup Node.js App → Environment variables ثبت کنید.
# هرگز فایل .env یا .env.local واقعی را در Git قرار ندهید (قانون ۵).

# محیط اجرا (development | production)
NODE_ENV=production

# دامنهٔ عمومی سایت (بدون اسلش پایانی) — پایهٔ ساخت canonical، hreflang، sitemap.xml و تصاویر OpenGraph
PUBLIC_SITE_URL=https://emmett.ir

# آدرس داخلی سرویس بک‌اند جنگو برای Server Components و پراکسی هم‌مبدأ /api/[...path]
# - اگر بک‌اند روی پورت لوکال اجراست: http://127.0.0.1:8000
# - اگر بک‌اند روی Phusion Passenger زیر مسیر داخلی دامنه نصب است: https://emmett.ir/backend
INTERNAL_API_URL=http://127.0.0.1:8000

# مسیر فیزیکی دایرکتوری media بک‌اند روی دیسک مشترک (اختیاری؛ پیش‌فرض: ../backend/media)
# برای بهینه‌ساز تصویر داخلی Next.js 16 (/_next/image) بدون دورزدن حفاظت SSRF
# MEDIA_ROOT=/home/cpanel_user/EmmettWebSiteUI/backend/media

# Shared only with Django's FRONTEND_REVALIDATE_SECRET; keep server-side (no NEXT_PUBLIC_ prefix).
FRONTEND_REVALIDATE_SECRET=
