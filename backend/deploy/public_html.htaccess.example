# نمونه فایل .htaccess ریشهٔ دامنه (public_html/.htaccess) روی هاست cPanel (ADR-0035، ADR-0036)
#
# توپولوژی مصوب: دامنهٔ واحد هم‌مبدأ (Single-Domain Same-Origin)
# - مسیرهای /static/ و /media/ مستقیماً از دیسک (یا سیم‌لینک در public_html) با هدرهای امنیتی سرو می‌شوند.
# - مسیرهای /admin/ و /i18n/ توسط اپلیکیشن پایتونی Django روی Passenger سرو می‌شوند.
# - سایر مسیرها (شامل /، /en/ و پراکسی /api/v1/*) توسط اپلیکیشن Node.js (Next.js) روی Passenger مدیریت می‌شوند.

<IfModule mod_rewrite.c>
    RewriteEngine On

    # ۱) اجبار HTTPS در تمام درخواست‌ها (قانون ۱۶)
    RewriteCond %{HTTPS} !=on
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # ۲) سرو مستقیم فایل‌های استاتیک و مدیا در صورت وجود فیزیکی روی دیسک
    RewriteCond %{REQUEST_URI} ^/(static|media)/ [NC]
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]
</IfModule>

# ۳) تزریق امن IP واقعی کلاینت، هدرهای امنیتی پایه و کش دارایی‌های استاتیک Apache
<IfModule mod_headers.c>
    # بازنویسی X-Forwarded-For با همتای TCP واقعی در لبهٔ Apache 2.4 تا هر هدر جعلی
    # ارسالی توسط کلاینت پاک شود و زنجیرهٔ Passenger Node (Next.js) -> Django دقیقاً IP
    # واقعی کاربر را ببیند (هم‌راستا با DJANGO_NUM_PROXIES=1 در .env).
    # توجه ۱: از نحو Apache 2.4 («expr=%{REMOTE_ADDR}») استفاده کنید، نه «%{REMOTE_ADDR}e»
    # که متغیر محیطی است و بدون SetEnv مقدار «(null)» تولید می‌کند.
    # توجه ۲: اگر سایت پشت CDN (کلادفلر/آروان) قرار گرفت و mod_remoteip روی هاست فعال نبود،
    # دستور «set» زیر را به «append» تغییر دهید و در .env مقدار DJANGO_NUM_PROXIES=2 بگذارید.
    # راستی‌آزمایی روی هاست واقعی: پس از ورود به /admin/، مسیر GET /api/v1/health/proxy/ را باز کنید.
    RequestHeader set X-Forwarded-For "expr=%{REMOTE_ADDR}"
    RequestHeader set X-Real-IP "expr=%{REMOTE_ADDR}"

    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "DENY"

    <FilesMatch "\.(woff2|woff|css|js|png|jpg|jpeg|webp|avif|svg|ico)$">
        Header set Cache-Control "public, max-age=2592000, immutable"
    </FilesMatch>
</IfModule>

# ۴) غیرفعال‌سازی کامل فهرست دایرکتوری‌ها و مسدودسازی دسترسی به فایل‌های نقطه (.env, .git)
Options -Indexes
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
